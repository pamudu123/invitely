# All values are optional in development.

# Hosted Postgres, the pooled connection. Leave empty to use an embedded one in .data/pg.
# POSTGRES_URL, set by the Supabase integration on Vercel, works too.
DATABASE_URL=
# Direct or session connection, used only by npm run db:migrate. POSTGRES_URL_NON_POOLING works too.
DIRECT_URL=

# Photo storage. Leave empty to keep photos in .data/media.
# The key stays on the server. SUPABASE_SERVICE_ROLE_KEY works too.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public address of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# off: publishing is free. manual: hold invitations until payment is confirmed.
PAYMENTS_MODE=off


# Password for the team area at /admin and for `npm run card`.
# Leave empty in development to use "admin". Required in production.
ADMIN_PASSWORD=
